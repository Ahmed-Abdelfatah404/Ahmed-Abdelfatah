{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ahmed-abdelfatah",
  "main": "functions/[[path]].js",
  "compatibility_date": "2024-09-04",
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ahmed-abdelfatah-db",
      "database_id": "995418cd-83b6-4987-9fac-6acd1e10f1a0"
    }
  ]
}
